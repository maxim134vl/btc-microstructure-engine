# VPS full-model deployment example — safe defaults only.
# Copy to .env (never commit secrets). No exchange trading credentials for paper mode.

# Compose / project
COMPOSE_PROJECT_NAME=btcml-vps
VPS_DEPLOYMENT_TAG=VPS_DEPLOY
VPS_IMAGE_TAG=local
VPS_VOLUME_NAME=btc_ml_data_vps

# Host port mapping (smoke uses 18080 / 15173 / 18765)
OPS_API_HOST_PORT=18080
DASHBOARD_UI_HOST_PORT=15173
TRADE_CHART_HOST_PORT=18765

# Public market-data
MARKET_SYMBOL=BTCUSDT

# Runtime
BTC_ML_REPO_ROOT=/app
BTC_ML_CONTEXT_REFRESH_DAEMON=1
CONTEXT_REFRESH_INTERVAL_SECONDS=900
PAPER_POLL_MS=250
PAPER_HEALTH_EVERY_S=2.0
VPS_COGNITION_MAX_AGE_S=180
DASHBOARD_POLL_INTERVAL=2.0
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# Hard safety (operator mirrors; config JSON remains authoritative)
PAPER_ONLY=true
REAL_EXECUTION_ENABLED=false
EXECUTION_ENABLED=false

# Healthcheck intervals (compose) — Desktop ~2GiB needs long start + generous timeout
HEALTH_INTERVAL=20s
HEALTH_TIMEOUT=15s
HEALTH_RETRIES=30
HEALTH_START_PERIOD=300s
COMPOSE_PROJECT_NAME=btcml-vps-smoke
VPS_VOLUME_NAME=btc_ml_data_vps_smoke
OPS_API_HOST_PORT=18080
DASHBOARD_UI_HOST_PORT=15173
TRADE_CHART_HOST_PORT=18765
