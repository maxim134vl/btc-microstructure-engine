digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 08 / STARTUP / READINESS / FAILURE DEPENDENCIES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">This is a data/readiness DAG, not invented Compose depends_on. RUNNING != fresh != source-qualified != PAPER OPEN permitted.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"base" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>RESTORED STORAGE / CONFIG / IMAGES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: operator / existing restore tooling</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Exact14 roles; existing data volumes and<BR ALIGN="LEFT"/>bind mappings</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Restore artifacts first; preserve state<BR ALIGN="LEFT"/>and identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Readable owned roots + accepted<BR ALIGN="LEFT"/>code/config</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Admission release/provenance, own-inputs, supervisor</FONT></TD></TR></TABLE>>, fillcolor="#FFF5DC"];
"ingress" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>INDEPENDENT MARKET OWNERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Watchdog + Legacy collector + Cognition</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Their existing exchange endpoints</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Receive / native store / original<BR ALIGN="LEFT"/>timestamping</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Real inputs; missing/freshness states<BR ALIGN="LEFT"/>remain explicit</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: registry, native-flow, Intrabar Cognition</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"native" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>NATIVE PAIRS / CANONICAL</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: native Legacy + Canonical</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Flow, Clusters, Spot OHLCV, source<BR ALIGN="LEFT"/>receipts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Availability guards before consumers;<BR ALIGN="LEFT"/>original order</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Admitted source generations or BLOCKED</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: memory, legacy-input, canonical</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"publisher" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>PUBLISHER / FOUR OWN CONTEXTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Closed inputs; frozen source pins; own<BR ALIGN="LEFT"/>history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: One daemon child; source checks; own-TF<BR ALIGN="LEFT"/>publication</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Final/Lifecycle/Phase, with actual<BR ALIGN="LEFT"/>timestamps</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Publisher, Context Phase, higher-tf</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"paper" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>PAPER NATIVE STARTUP</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: paper-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Existing financial descriptor,<BR ALIGN="LEFT"/>provenance, release pins, policy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Check before writer; current Futures<BR ALIGN="LEFT"/>stream; REAL off</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Native books + market health + existing<BR ALIGN="LEFT"/>writer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Admission release/provenance, paper-runner, own-<BR ALIGN="LEFT"/>inputs</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"r08" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>R08 OBSERVER BOOTSTRAP</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Paper child</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Native startup gate + genuine new Spot;<BR ALIGN="LEFT"/>real own Context</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Receive prefix -&gt; fix300s baseline/INIT -&gt;<BR ALIGN="LEFT"/>handoff</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Descriptor/source binding only when<BR ALIGN="LEFT"/>actually produced</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: R08 child owner, Baseline provider, R08<BR ALIGN="LEFT"/>adapter/handoff</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"manager" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>TIMEFRAME MANAGER READER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: timeframe-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Financial environment + own context +<BR ALIGN="LEFT"/>source bindings</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Missing technical input remains BLOCKED;<BR ALIGN="LEFT"/>no fabricated permission</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Cycles/commands; valid market wait may<BR ALIGN="LEFT"/>be NO_ACTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Manager daemon, own-inputs, Entry conditions</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"monitor" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>API / VISUAL / UI / SUPERVISION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: read-only owners</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Actual heartbeat and owner publications</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Separate process health, stale data and<BR ALIGN="LEFT"/>market observation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Observable degraded/missing/current<BR ALIGN="LEFT"/>state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: api, Visual projection, nginx, supervisor</FONT></TD></TR></TABLE>>, fillcolor="#EEF0F3"];
"base" -> "ingress" [label="08E01 · Writable existing roots and config\nexisting mounts / images\nbefore normal process startup", color="#BA7A10", style=dashed];
"ingress" -> "native" [label="08E02 · Real available source generations\nnative snapshots / OHLCV\ndependency-ready guards", color="#147D83"];
"native" -> "publisher" [label="08E03 · Closed admitted inputs\nseven INPUTS + native source snapshots\nsafe-close; one native child", color="#147D83"];
"base" -> "paper" [label="08E04 · Exact financial environment\nexisting historical provenance + current\nrelease manifest\nbefore writer creation", color="#BA7A10", style=dashed];
"paper" -> "r08" [label="08E05 · Existing observer child launcher\nsame Paper container\nnative startup admission; no S0 fabricated", color="#BA7A10", style=dashed];
"publisher" -> "r08" [label="08E06 · Real own Context / Phase references\nexisting source binding inputs\nexisting causal availability rules", color="#147D83"];
"paper" -> "manager" [label="08E07 · Valid financial environment /\npositions\nshared authoritative runtime\nnative startup/readiness", color="#147D83"];
"publisher" -> "manager" [label="08E08 · Own admitted context\nFinal/Lifecycle/Phase publications\nexisting input availability", color="#147D83"];
"r08" -> "manager" [label="08E09 · Actually published source/descriptor\n/r08 committed bindings\nno pre-created fake INIT/permission", color="#147D83"];
"ingress" -> "monitor" [label="08E10 · Actual status / owner output\nread-only files / Docker GET\nnative status/poll", color="#8996A5", style=dotted, constraint=false];
"native" -> "monitor" [label="08E11 · Actual status / owner output\nread-only files / Docker GET\nnative status/poll", color="#8996A5", style=dotted, constraint=false];
"publisher" -> "monitor" [label="08E12 · Actual status / owner output\nread-only files / Docker GET\nnative status/poll", color="#8996A5", style=dotted, constraint=false];
"paper" -> "monitor" [label="08E13 · Actual status / owner output\nread-only files / Docker GET\nnative status/poll", color="#8996A5", style=dotted, constraint=false];
"manager" -> "monitor" [label="08E14 · Actual status / owner output\nread-only files / Docker GET\nnative status/poll", color="#8996A5", style=dotted, constraint=false];
}
