digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 07 / PERSISTENCE / HISTORY / TRAINING</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Historical masters are separate worlds. There is NO demonstrated automatic live PAPER -&gt; canonical Master bridge; no<BR ALIGN="LEFT"/>time/price identity joins.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"raw" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>ORIGINAL MARKET EVIDENCE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Recorder / feed / Paper WAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Source messages + original receive/source<BR ALIGN="LEFT"/>clocks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Durable publication; original receipts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: RAW/ACK; OHLCV partitions; Futures WAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Recorder storage, feed-paths, Execution WAL</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"derived" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>DERIVED FEATURES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Canonical / native Legacy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Admitted market and preceding state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original feature calculations / generation<BR ALIGN="LEFT"/>metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Canonical/native Parquet history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical, legacy-input</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"contexts" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>OWN CONTEXT HISTORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Publisher / Cognition</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Derived inputs + original availability</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Own Final/Lifecycle/Phase; separate CTX<BR ALIGN="LEFT"/>events</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Context/episode/source IDs, not trade<BR ALIGN="LEFT"/>IDs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Publisher, Intrabar Cognition</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"decisions" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>DECISION / COMMAND HISTORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Manager / CommandBus</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Context + source/permission + positions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Existing decision conditions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: decision_id / command_id / TF / lineage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: CommandBus, Timeframe Manager</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"outcomes" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CURRENT PAPER OUTCOMES</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Paper financial authority</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Committed commands and genuine execution<BR ALIGN="LEFT"/>market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original position/order/fill/trade<BR ALIGN="LEFT"/>association</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: PAPER books / receipts / costs /<BR ALIGN="LEFT"/>outcomes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Financial authority, Paper engine</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"history" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>HISTORICAL RECONSTRUCTION INPUTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: preserved research scripts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Causal bars/states;<BR ALIGN="LEFT"/>baseline/counterfactual candidates; worlds</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original research build, not this task</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Exact source/run/availability registries</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: master, master-worlds</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"master" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CANONICAL MASTER BOOKS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: historical run_stage_09.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Explicit bar/candidate/outcome keys and<BR ALIGN="LEFT"/>worlds</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Separate BAR / STATE / CANDIDATE / OUTCOME</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: 17409 candidates;39035 MULTI_WORLD<BR ALIGN="LEFT"/>outcomes (snapshot)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: master, master-worlds, master-links</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"training" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>TRAINING / CALIBRATION LOCATORS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: preserved dataset owners</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Explicit candidate IDs + CI03 causal X;<BR ALIGN="LEFT"/>labels separate</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original split/feature/label/provenance<BR ALIGN="LEFT"/>manifests</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Existing datasets; no new fit or labels</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: training-core, training-order</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"future" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>FUTURE SYNTHETIC CORPUS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: NOT IMPLEMENTED / NO CURRENT WRITER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: No runtime input asserted</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Requested future boundary only</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: No current dataset or automatic bridge</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Requested future boundary; NOT IMPLEMENTED</FONT></TD></TR></TABLE>>, fillcolor="#F5EDFA", style="rounded,dashed,filled"];
"raw" -> "derived" [label="07E01 · Admitted source data\nnative readers / Parquet\nsource availability at evaluation", color="#147D83"];
"derived" -> "contexts" [label="07E02 · Owned classifier inputs\nsource-bound generations\nown closed bar / event-time update", color="#147D83"];
"contexts" -> "decisions" [label="07E03 · Own closed-context lineage\nParquet + explicit bindings\nmanager evaluation", color="#147D83"];
"decisions" -> "outcomes" [label="07E04 · Command -> position/order/fill/trade\nnative committed associations\nexisting execution conditions", color="#147D83"];
"history" -> "master" [label="07E05 · Explicit world/run and identity\nlinks\nhistorical original Parquet + manifests\noriginal research build only", color="#147D83"];
"master" -> "training" [label="07E06 · Candidate identity / original\nprovenance\nexact candidate_id/TF/side/close comparison\nsaved historical research build", color="#147D83"];
"history" -> "training" [label="07E07 · CI03 admitted causal X + original\nlabel sources\nsaved field/split/availability contracts\nsaved historical dataset build; no automatic\nrun", color="#147D83"];
}
