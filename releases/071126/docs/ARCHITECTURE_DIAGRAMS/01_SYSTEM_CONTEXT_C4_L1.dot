digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 01 / SYSTEM CONTEXT · C4 L1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">PAPER is simulated execution. Market observation, technical health and entry permission are distinct.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"spot" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BINANCE SPOT · BTCUSDT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: external exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Distinct source domains</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: kline / aggTrade / bookTicker</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: feed, Spot transport, Intrabar Cognition</FONT></TD></TR></TABLE>>, fillcolor="#FFF1DD"];
"futures" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BINANCE FUTURES · BTCUSDT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: external exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Futures market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: REST snapshots + execution WSS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: trades / aggTrade / BBO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: native-flow, paper-runner</FONT></TD></TR></TABLE>>, fillcolor="#FFF1DD"];
"system" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BTC-ML · RELEASE 071126</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: 14 Docker services</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot + Futures; original source clocks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Ingest / Canonical / contexts / decisions<BR ALIGN="LEFT"/>/ PAPER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Owned generations, commands, PAPER state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical, Publisher, Paper engine</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"state" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>PERSISTED STATE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: existing owners</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: RAW, features, context, decision,<BR ALIGN="LEFT"/>financial state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original IDs, availability and provenance</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Private volumes + bound R08 runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Recorder storage, Journal V3, Financial authority</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"monitor" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>DASHBOARD + CHART / OPS API</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: dashboard-ui + ops-api</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Owner publications and process status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Read-only projections; no fabricated trade</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Operator observations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: nginx, api, api-chart</FONT></TD></TR></TABLE>>, fillcolor="#E5F5F8"];
"paper" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>PAPER OUTPUTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: paper-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Admitted commands and genuine market<BR ALIGN="LEFT"/>prices</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Risk / costs / positions / SL / TP / CLOSE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Books, receipts, outcomes, reasons</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Paper engine, Risk/economics, Financial authority</FONT></TD></TR></TABLE>>, fillcolor="#E5F5F8"];
"real" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>REAL EXECUTION DISABLED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: existing execution guard</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: REAL_EXECUTION_ENABLED=false</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: No REAL route activated by this task</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: No live exchange orders</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: own-inputs</FONT></TD></TR></TABLE>>, fillcolor="#FFF5DC"];
"operator" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>OPERATOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: system owner</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Dashboard / Chart / technical API views</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Read system and PAPER observations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Human observation; no automatic REAL<BR ALIGN="LEFT"/>route</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: nginx, ui</FONT></TD></TR></TABLE>>, fillcolor="#FFF1DD"];
subgraph cluster_btcml { label="BTC-ML SYSTEM BOUNDARY · FOURTEEN SERVICES · PAPER ONLY"; color="#A8BDCF"; style="rounded"; "system"; "state"; "monitor"; "paper"; "real"; }
"spot" -> "system" [label="01E01 · Spot observations\nWSS native/combined JSON\nsource messages", color="#147D83"];
"futures" -> "system" [label="01E02 · Futures observations\nREST JSON / WSS JSON\nnative polling / source messages", color="#147D83"];
"system" -> "state" [label="01E03 · Owner writes\ndurable RAW; Parquet / JSON / Journal V3\nnative commit/publication", color="#147D83"];
"system" -> "monitor" [label="01E04 · Context and technical status\nHTTP JSON + visual projection files\nUI/API poll; visual input changes", color="#147D83"];
"system" -> "paper" [label="01E05 · Existing PAPER decisions\nCommandBus Parquet + financial commit\nOPEN / HOLD / CLOSE / NO_ACTION", color="#147D83"];
"system" -> "real" [label="01E06 · REAL remains forbidden\nexisting config + guard\nall execution attempts", color="#BA7A10", style=dashed];
"monitor" -> "operator" [label="01E07 · Context / PAPER / technical views\nbrowser HTTP / WS / JSON\noperator read-only requests", color="#8996A5", style=dotted, constraint=false];
}
