digraph OVERVIEW {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.3, ranksep=0.6, splines=polyline, fontname="Arial", newrank=true];
node [shape=box, style="rounded,filled", fillcolor="#E8F0FA", color="#B8CADB", fontname="Arial", fontsize=13, margin="0.14,0.10"];
edge [color="#147D83", fontname="Arial", fontsize=10, arrowsize=0.65];
graph [label="BTC-ML / 02A / FOURTEEN CONTAINERS — OVERVIEW\nRelease 071126 · 08 November 2026 · Detailed IO: 02_ALL_14_CONTAINERS_C4_L2 + ARCHITECTURE_SOURCE_INDEX\nTeal: data · Amber dashed: control · Gray dotted: observation · Labels map to exact source-index edge IDs",labelloc=t,labeljust=l,fontsize=22];
