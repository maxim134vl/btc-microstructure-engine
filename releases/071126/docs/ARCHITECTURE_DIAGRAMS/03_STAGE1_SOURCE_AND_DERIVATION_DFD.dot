digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 03 / STAGE1 · SOURCE AND DERIVATION DFD</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Spot OHLCV proxies and native Futures flow remain separate. Canonical order is the actual 28-engine registry.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"spot" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BINANCE SPOT · BTCUSDT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: external exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Distinct source domains</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: kline / aggTrade / bookTicker</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: feed, Spot transport, Intrabar Cognition</FONT></TD></TR></TABLE>>, fillcolor="#FFF1DD"];
"futures" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BINANCE FUTURES · BTCUSDT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: external exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Futures market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: REST snapshots + execution WSS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: trades / aggTrade / BBO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: native-flow, paper-runner</FONT></TD></TR></TABLE>>, fillcolor="#FFF1DD"];
"flow" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>FUTURES NATIVE FLOW</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-multi-exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Futures REST trades</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: buy/sell/delta/count/efficiency snapshots</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: multi_exchange_flow.parquet</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: native-flow</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"clusters" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CLUSTERS + INVENTORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-volume-clusters</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: flow snapshot + own history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Unchanged native engines; admitted IO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: volume_clusters / inventory_states</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: clusters, inventory</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"memory" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>MEMORY + REGIME</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-volume-memory</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: flow + clusters + own history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Unchanged native engines; admitted IO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: volume_memory / regime_history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: memory, regime</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"react" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>REACTIONS + ACCEPTANCE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-volume-reactions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: flow snapshot + own history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Unchanged native engines; admitted IO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: volume_reactions / acceptance_states</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: reactions, acceptance</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"feed" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>SPOT OHLCV INGRESS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: collector-watchdog</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot kline_15m updates</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Canonical snapshot + daily partitions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: data/live/live_market_feed.parquet</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: registry, feed, feed-paths</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"candle" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CANDLE / LOCALIZATION / VOLUME</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: canonical-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot OHLCV</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Candle structure; geometry; localization;<BR ALIGN="LEFT"/>volume classification</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: candle_structure / volume_localization /<BR ALIGN="LEFT"/>volume_classification</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"guard" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>NATIVE SOURCE AVAILABILITY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: canonical-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Legacy publication + original metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: read_consumer_source /<BR ALIGN="LEFT"/>read_available_source</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Admitted snapshot or BLOCKED</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: legacy-input, volume-response</FONT></TD></TR></TABLE>>, fillcolor="#FFF5DC"];
"response" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BEHAVIOR / RESPONSE / CONVERGENCE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: canonical-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Candle/localization + admitted reactions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Behavioral memory; volume response;<BR ALIGN="LEFT"/>climatic and auction convergence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: volume_response_state;<BR ALIGN="LEFT"/>auction_convergence_memory</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical, volume-response</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"synth" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>FLOW / LIQUIDITY / HTF / SYNTHESIS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: canonical-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Spot derived features + prior engine<BR ALIGN="LEFT"/>results</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Live flow -&gt; clusters -&gt; interaction; HTF<BR ALIGN="LEFT"/>structure/context -&gt; synthesis</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: auction_synthesis_memory + context-<BR ALIGN="LEFT"/>related outputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"out" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CANONICAL OUTPUT GENERATIONS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: canonical-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Ordered successful engine results</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Runtime guard + owner publication metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Stage2/cognition + MTF availability;<BR ALIGN="LEFT"/>Publisher inputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"futures" -> "flow" [label="03E01 · Futures trades\nREST JSON\nnative poll", color="#147D83"];
"flow" -> "clusters" [label="03E02 · Flow snapshot\nParquet + native publication\nnative30/60s loops", color="#147D83"];
"flow" -> "memory" [label="03E03 · Flow snapshot\nParquet + native publication\nnative30/60s loops", color="#147D83"];
"flow" -> "react" [label="03E04 · Flow snapshot\nParquet + native publication\nnative30/60s loops", color="#147D83"];
"clusters" -> "memory" [label="03E05 · Cluster profile\nvolume_clusters.parquet\nnative Memory read", color="#147D83"];
"clusters" -> "guard" [label="03E06 · Inventory generation\nParquet + receipt/availability metadata\nconsumer evaluation cutoff", color="#147D83"];
"memory" -> "guard" [label="03E07 · Regime generation; Memory stays\nnative history\nParquet + receipt/availability metadata\nconsumer evaluation cutoff", color="#147D83"];
"react" -> "guard" [label="03E08 · Reactions / Acceptance generation\nParquet + receipt/availability metadata\nconsumer evaluation cutoff", color="#147D83"];
"spot" -> "feed" [label="03E09 · Spot candle updates\nkline_15m WSS JSON\nsource update", color="#147D83"];
"feed" -> "candle" [label="03E10 · OHLCV history\nParquet / partitions\ndependency-ready pass", color="#147D83"];
"candle" -> "response" [label="03E11 · Own derived measurements\ncanonical Parquet outputs\npipeline order", color="#147D83"];
"guard" -> "response" [label="03E12 · Admitted reactions / behavioral\ninputs\nsource-bound reader\nnot future/backdated", color="#147D83"];
"candle" -> "synth" [label="03E13 · Own localization / flow / HTF inputs\ncanonical Parquet\nregistered producer order", color="#147D83"];
"response" -> "synth" [label="03E14 · Response and convergence\ncanonical memory files\nregistered producer order", color="#147D83"];
"synth" -> "out" [label="03E15 · Synthesis then registered cognition\nstages\nowner generations\nnative sequential guard", color="#147D83"];
}
