digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 06 / TRADING DECISION / COMMAND / PAPER EXECUTION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Context != signal != position != execution. Intrabar Supervisor observes Compose-owned processes; Paper owns fills and<BR ALIGN="LEFT"/>protection.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"context" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>OWN CONTEXT OWNERS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Publisher / existing readers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Final/Lifecycle/Phase + availability</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Closed-bar S4.1 inputs; no provisional<BR ALIGN="LEFT"/>replacement</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Own M15/M30/H1/H4 context state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: own-inputs, state-adapter</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"gate" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>ADMISSION / READINESS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: existing guards</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Descriptor/source/permission; release<BR ALIGN="LEFT"/>pins; fresh market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Keep BLOCKED / STALE separate from market<BR ALIGN="LEFT"/>OBSERVE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Existing entry permission or exact<BR ALIGN="LEFT"/>reason</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Admission release/provenance, Entry conditions, own-<BR ALIGN="LEFT"/>inputs</FONT></TD></TR></TABLE>>, fillcolor="#FFF5DC"];
"manager" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>TIMEFRAME MANAGER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: timeframe-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own context + positions/risk + trend<BR ALIGN="LEFT"/>metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original OPEN/HOLD/CLOSE/NO_ACTION rules</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Deterministic own-TF command_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Timeframe Manager, Manager daemon</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"bus" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>COMMANDBUS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: timeframe-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: New commands</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Immutable logical prefix; deterministic ID<BR ALIGN="LEFT"/>dedupe</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: timeframe_command_memory.parquet</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: CommandBus</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"consume" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>OWN-TF COMMAND CONSUMER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Paper child / single writer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: CommandBus + own cursor + TTL/source/risk<BR ALIGN="LEFT"/>contracts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Reject stale/duplicate/unowned commands</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Exactly-once effect path; cursor<BR ALIGN="LEFT"/>checkpoint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: consumer, Paper engine</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"market" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>FUTURES EXECUTION MARKET</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Paper transport/WAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Futures aggTrade + BBO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Durable WAL and current fresh-price guards</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Original market events / BBO / gaps<BR ALIGN="LEFT"/>state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: paper-runner, Execution WAL, Execution checkpoint</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"paper" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>PAPER ENGINE / POSITION MANAGEMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: paper-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Valid command + original market +<BR ALIGN="LEFT"/>existing position</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Risk sizing; fees/slippage; SL/TP;<BR ALIGN="LEFT"/>intrabar HOLD/CLOSE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Committed PAPER positions/trades/reasons</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Paper engine, Risk/economics, Financial authority</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"financial" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>FINANCIAL COMMIT / BOOKS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: existing financial authority</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Paper effect + costs + position identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original generation/receipt/order and<BR ALIGN="LEFT"/>accounting</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Position/trade books; financial<BR ALIGN="LEFT"/>generation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Financial authority</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"ack" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>COMMAND CURSOR / ACK</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: S41CommandConsumer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Committed effect / native disposition</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Do not repeat command effects</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: s41_command_cursor.json and native<BR ALIGN="LEFT"/>receipts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: consumer</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"observe" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>INTRABAR SUPERVISOR / DASHBOARD</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: intrabar-supervisor + OPS/UI</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Process heartbeat and owner outputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Compose-owned observation; no second<BR ALIGN="LEFT"/>writer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Technical status / read-only views</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: supervisor, api, nginx</FONT></TD></TR></TABLE>>, fillcolor="#EEF0F3"];
"context" -> "manager" [label="06E01 · Own context state\nown-TF Parquet / publication\nconfigured60s evaluation", color="#147D83"];
"gate" -> "manager" [label="06E02 · Existing readiness/entry decision\nexplicit configured bindings\nbefore applicable OPEN", color="#BA7A10", style=dashed];
"manager" -> "bus" [label="06E03 · OPEN_LONG / OPEN_SHORT / HOLD /\nCLOSE / NO_ACTION\natomic Parquet command rows\nnew deterministic command_id", color="#147D83"];
"bus" -> "consume" [label="06E04 · Own-TF commands\nCommandBus Parquet\nconsumer polling; own cursor", color="#147D83"];
"consume" -> "paper" [label="06E05 · Validated command\napply_s41_manager_command\none effect per admitted command", color="#BA7A10", style=dashed];
"market" -> "paper" [label="06E06 · Current executable market\nobservations\nFutures WAL / BBO\ncontinuous protective handling", color="#147D83"];
"paper" -> "financial" [label="06E07 · Effect + costs + CLOSE accounting\nnative financial transaction\nexisting durability order", color="#147D83"];
"financial" -> "ack" [label="06E08 · Effect already committed\nnative consumer checkpoint/disposition\ncommit before acknowledgement", color="#BA7A10", style=dashed];
"financial" -> "manager" [label="06E09 · Current position/risk view\nexisting authoritative books\nmanager evaluation", color="#147D83"];
"financial" -> "observe" [label="06E10 · Committed outcome/position state\nread-only owner publications\nAPI snapshot", color="#8996A5", style=dotted, constraint=false];
"paper" -> "observe" [label="06E11 · Health and process state\nheartbeat / PID / health JSON\nnative supervision", color="#8996A5", style=dotted, constraint=false];
}
