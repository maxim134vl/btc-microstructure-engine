digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 05 / FOUR INDEPENDENT TIMEFRAME CONTEXTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Higher bars may resample closed M15 OHLCV; M15 Final/Lifecycle is never substituted for a higher-TF classification. CTX ID is<BR ALIGN="LEFT"/>not trade ID.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"market" [shape=cylinder, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CLOSED MARKET + NATIVE INPUTS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: existing owners</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot OHLCV + admitted source generations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Own cutoff / availability</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Own-TF classifier inputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Publisher, higher-tf</FONT></TD></TR></TABLE>>, fillcolor="#E6F5F1"];
"manager" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>TIMEFRAME MANAGER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: timeframe-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Final/Lifecycle/Phase + source<BR ALIGN="LEFT"/>metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Independent M15 / M30 / H1 / H4 evaluation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Commands, not fills or positions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: own-inputs, state-adapter, Timeframe Manager</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"m15bar" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>M15 · OWN CLOSED BAR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: M15 classifier owner</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own market range and source cutoff</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: 900s bar; real boundaries</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Own completed-bar generation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: higher-tf, Publisher</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"m15final" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>M15 · FINAL</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Auction/Cognitive inputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original Final classifier</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Own final_market_context_memory.parquet</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Final Context, higher-tf</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"m15life" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>M15 · LIFECYCLE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own consecutive Final + Stage2<BR ALIGN="LEFT"/>conclusions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Original process and episode reducer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Own lifecycle, episode, strength</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Lifecycle, higher-tf</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"m15phase" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>M15 · TREND / PHASE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: own publication / integration</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Lifecycle process_strength + native<BR ALIGN="LEFT"/>evidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Existing numeric strength + qualified<BR ALIGN="LEFT"/>Phase</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Own-TF publication + availability</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Context Phase, Trend Strength integration</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
