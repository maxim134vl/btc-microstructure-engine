"h1bar" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>H1 · OWN CLOSED BAR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: H1 classifier owner</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own market range and source cutoff</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: 3600s bar; real boundaries</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Own completed-bar generation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: higher-tf, Publisher</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
