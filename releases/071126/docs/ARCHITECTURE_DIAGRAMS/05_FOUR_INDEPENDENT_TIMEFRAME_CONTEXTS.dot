"seal" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>R08 OWN-TF COVERAGE SEAL</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Paper adapter / ResearchSystem</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Exact closed bar + actual local session<BR ALIGN="LEFT"/>coverage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Match TF/bar; partial initial bar is not<BR ALIGN="LEFT"/>sealed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Committed own-TF watermark or<BR ALIGN="LEFT"/>WAITING_FOR_COVERAGE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: R08 adapter/handoff, R08 ResearchSystem</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
