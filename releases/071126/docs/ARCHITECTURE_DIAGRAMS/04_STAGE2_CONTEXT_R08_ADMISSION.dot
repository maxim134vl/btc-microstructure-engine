digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 04 / STAGE2 / CONTEXT / R08 / ADMISSION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Intrabar observations do not replace closed-bar S4.1 entry authority. R08 is evidence, never an artificial trading signal.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"canon" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CANONICAL STAGE2 / COGNITION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: canonical-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Stage1 derived features</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Registered<BR ALIGN="LEFT"/>Stage2/runtime/intermediate/meta-cognition</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: cognition and availability generations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"freeze" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>PUBLISHER SOURCE SNAPSHOT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Seven market/cognition INPUTS + native<BR ALIGN="LEFT"/>frames</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Stage/freeze/pin before classifiers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Immutable per-pass inputs + source pins</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Publisher, native-stage2</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"auction" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>NATIVE AUCTION / OWN CONTEXT BUILD</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Pinned closed-bar inputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Native Auction; own Cognitive; own Final</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Auction/Cognitive/Final generations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Publisher, m15-boundary, higher-tf</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"shadow" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>PRIVATE SEPTEMBER BOUNDARY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Existing M15 Auction history + prior<BR ALIGN="LEFT"/>boundary</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Private shadow reconstruction; not<BR ALIGN="LEFT"/>published old history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: New causal suffix, with original<BR ALIGN="LEFT"/>provenance</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: m15-boundary</FONT></TD></TR></TABLE>>, fillcolor="#FFF5DC"];
"life" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>LIFECYCLE + STAGE2 CONCLUSIONS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Final; admitted predecision Stage2<BR ALIGN="LEFT"/>evidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Own process continuity and episode<BR ALIGN="LEFT"/>transitions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Lifecycle + stage2 consumption evidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Lifecycle, native-stage2, m15-boundary</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"phase" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>CONTEXT PHASE / OWNER RELEASE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Lifecycle/native history +<BR ALIGN="LEFT"/>predecision evidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Publish own-TF generation after required<BR ALIGN="LEFT"/>checks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Final / Lifecycle / Context Phase<BR ALIGN="LEFT"/>publications</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Context Phase, Publisher, higher-tf</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"intrabar" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>INTRABAR COGNITION (PARALLEL)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: cognition-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Independent Spot aggTrade/BBO; admitted<BR ALIGN="LEFT"/>closed contexts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Event-time bars; provisional<BR ALIGN="LEFT"/>synthesis/lifecycle</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: CTX events + provisional health</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Intrabar Cognition, Cognition Pipeline, Closed-bar<BR ALIGN="LEFT"/>bridge</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"r08" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>R08 + DRA / R2</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Paper child / existing reducers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Genuine Spot; frozen300s baseline;<BR ALIGN="LEFT"/>Context; predecessor</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Existing A/B/R -&gt; economic evidence -&gt;<BR ALIGN="LEFT"/>C_E/C_P projections</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Committed source/evidence; qualification<BR ALIGN="LEFT"/>remains explicit</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: R08 ResearchSystem, R08 evidence, Journal V3</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"trend" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>TREND / LIVING PROCESS INTEGRATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: timeframe-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Own Final/Lifecycle process_strength +<BR ALIGN="LEFT"/>Phase + R08 metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Read existing numeric strength; bind own<BR ALIGN="LEFT"/>lineage</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Separate metadata; no new numeric<BR ALIGN="LEFT"/>formula or permission</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Trend Strength integration, own-inputs</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
"gate" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>EXISTING DECISION / OPEN GUARDS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: Timeframe Manager + Paper</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Source/descriptor/policy; market<BR ALIGN="LEFT"/>freshness; qualification</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Missing technical input = BLOCKED; valid<BR ALIGN="LEFT"/>market wait = NO_ACTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Only existing conditions can permit<BR ALIGN="LEFT"/>PAPER OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Entry conditions, Timeframe Manager, Paper engine</FONT></TD></TR></TABLE>>, fillcolor="#FFF5DC"];
"canon" -> "freeze" [label="04E01 ·\nCandle/response/convergence/cognition\nseven frozen INPUTS\nPublisher native pass", color="#147D83"];
"freeze" -> "auction" [label="04E02 · Pinned source frames\nNativeSourcePass + exact SHA\nbefore classification", color="#147D83"];
"auction" -> "shadow" [label="04E03 · M15 causal boundary work\nprivate staging tree\nown M15 build", color="#147D83"];
"auction" -> "life" [label="04E04 · Own Final and admitted conclusions\nParquet + stage2 predecision reader\nown generation", color="#147D83"];
"shadow" -> "life" [label="04E05 · New M15 suffix; legacy prefix frozen\nsame original classifiers\nboundary-preserving append", color="#147D83"];
"life" -> "phase" [label="04E06 · Own process evidence\nsource-bound publications\ncomplete own TF", color="#147D83"];
"phase" -> "intrabar" [label="04E07 · Closed contexts\nClosedBarContextEventBridge\nnew admitted closed bar", color="#147D83"];
"phase" -> "r08" [label="04E08 · Real own-TF Context references\nexisting Context/source binding\navailable before required initiative", color="#147D83"];
"phase" -> "trend" [label="04E09 · Own strength / phase\npublished Final/Lifecycle/Phase\nmanager read", color="#147D83"];
"r08" -> "trend" [label="04E10 · Committed DRA/R2 lineage metadata\nJournalV3 + descriptor / direct reader\nsource refresh", color="#147D83"];
"trend" -> "gate" [label="04E11 · Separate trend metadata\nexisting controller input\nexisting decision evaluation", color="#147D83"];
}
