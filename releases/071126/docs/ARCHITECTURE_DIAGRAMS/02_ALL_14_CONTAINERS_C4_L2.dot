digraph BTCML {
graph [rankdir=LR, bgcolor="white", pad="0.45", nodesep="0.40", ranksep="0.85", splines=polyline, fontname="Arial", newrank=true, compound=true];
node [shape=box, style="rounded,filled", color="#CBD5E1", penwidth=1.2, fontname="Arial", fontsize=12, margin="0.18,0.13"];
edge [fontname="Arial", fontsize=10, color="#147D83", fontcolor="#334155", penwidth=1.4, arrowsize=0.7];
graph [label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#102A43"><B>BTC-ML / 02 / ALL 14 CONTAINERS · C4 L2</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Release 071126 · installed-source model · 08 November 2026 · Source/edge index accompanies this SVG</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">R08 is a Paper child, not a fifteenth service. Diagram arrows describe implemented IO, not current freshness.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#52606D">DATA: teal solid | CONTROL/GUARD: amber dashed | HEALTH/OBSERVATION: gray dotted | STORED STATE: green | FUTURE: purple, no runtime edge</FONT></TD></TR></TABLE>>, labelloc=t, labeljust=l];
"spot" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BINANCE SPOT · BTCUSDT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: external exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Distinct source domains</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: kline / aggTrade / bookTicker</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: feed, Spot transport, Intrabar Cognition</FONT></TD></TR></TABLE>>, fillcolor="#FFF1DD"];
"futures" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>BINANCE FUTURES · BTCUSDT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: external exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Futures market</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: REST snapshots + execution WSS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: trades / aggTrade / BBO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: native-flow, paper-runner</FONT></TD></TR></TABLE>>, fillcolor="#FFF1DD"];
"canonical-runtime" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-canonical-runtime-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: canonical-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Watchdog feed и native Legacy outputs;<BR ALIGN="LEFT"/>после входной проверки dependency guard</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Последовательный Stage1/Stage2 pipeline,<BR ALIGN="LEFT"/>run.py → runtime/pipeline.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: cognition/*.parquet,<BR ALIGN="LEFT"/>runtime_engine_state, availability/metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: canonical, legacy-input, volume-response</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"context-refresh-daemon" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-context-refresh-daemon-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresh-daemon</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Пригодные собственные native frames и<BR ALIGN="LEFT"/>Stage2 evidence; admission и source pins</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Publisher Final/Lifecycle/Context Phase<BR ALIGN="LEFT"/>четырёх TF; один causal child</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: live/primary_context_publication.json,<BR ALIGN="LEFT"/>live/context_refresh_daemon_status.json; own-TF<BR ALIGN="LEFT"/>Final/Lifecycle, phase generations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Publisher, pub-daemon</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"context-refresher" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-context-refresher-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: context-refresher</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Опубликованные<BR ALIGN="LEFT"/>Final/Lifecycle/trade/phase источники; /profile<BR ALIGN="LEFT"/>— диагностика</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Подготовка read-only visual projections из<BR ALIGN="LEFT"/>owner outputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: visual public volume; /profile<BR ALIGN="LEFT"/>diagnostics</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Visual projection</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"legacy-volume-memory" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-legacy-volume-memory-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-volume-memory</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: multi_exchange_flow + volume_clusters;<BR ALIGN="LEFT"/>own history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Native Memory/Regime pair под IO wrapper</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: /legacy native Memory/Regime parquet и<BR ALIGN="LEFT"/>/legacy/ops provenance</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: memory, regime</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"legacy-volume-reactions" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-legacy-volume-reactions-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-volume-reactions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Текущий multi_exchange_flow snapshot из<BR ALIGN="LEFT"/>/legacy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Native Reactions/Acceptance pair</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: /legacy native Reactions/Acceptance и<BR ALIGN="LEFT"/>/legacy/ops</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: reactions, acceptance</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"legacy-volume-clusters" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-legacy-volume-clusters-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-volume-clusters</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: /legacy multi_exchange_flow + проверенные<BR ALIGN="LEFT"/>native source pins</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Native Clusters/Inventory pair с текущим<BR ALIGN="LEFT"/>pass-local snapshot reuse</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: /legacy native Clusters/Inventory + ops<BR ALIGN="LEFT"/>capture/published metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: clusters, inventory</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"legacy-multi-exchange" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-legacy-multi-exchange-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: legacy-multi-exchange</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Реальные соединения сборщика; точные<BR ALIGN="LEFT"/>endpoints в сохранённом source</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Сборщик multi-exchange flow под IO runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: /legacy multi_exchange_flow parquet, ops<BR ALIGN="LEFT"/>source evidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: native-flow</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"dashboard-ui" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-dashboard-ui-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: dashboard-ui</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Статика image, /visual-data RO,<BR ALIGN="LEFT"/>/release/manifest.json RO, внутренний ops-api</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Один nginx: Dashboard + встроенный Market<BR ALIGN="LEFT"/>Context/legacy Chart</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: 127.0.0.1:15173; :18765 только Chart<BR ALIGN="LEFT"/>static/GET projection</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: nginx, ui</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"ops-api" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-ops-api-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: ops-api</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Data/visual RO, release manifest RO,<BR ALIGN="LEFT"/>Docker socket RO и действующий socket GID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Read-only FastAPI/WS транспорт owner<BR ALIGN="LEFT"/>данных и bounded Docker GET telemetry</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: 127.0.0.1:18080; health/runtime/chart<BR ALIGN="LEFT"/>projections</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: api, api-chart</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"collector-watchdog" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-collector-watchdog-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: collector-watchdog</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Сохранённая конфигурация collectors; в P0<BR ALIGN="LEFT"/>фактически работал live_binance_feed_v2 child</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Watchdog штатных required collectors</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Feed parquet, collector heartbeats и<BR ALIGN="LEFT"/>штатные logs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: registry, feed</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"cognition-runtime" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-cognition-runtime-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: cognition-runtime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot BTCUSDT aggTrade/bookTicker;<BR ALIGN="LEFT"/>нормализация source/session/receive metadata</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: LIVE1A Spot stream, архив<BR ALIGN="LEFT"/>raw_event_journal и provisional cognition</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: raw_market_events_v2;<BR ALIGN="LEFT"/>cognition/intrabar_context_events;<BR ALIGN="LEFT"/>runtime/intrabar_cognition_health.json</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Intrabar Cognition, Closed-bar bridge</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"paper-manager" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-paper-manager-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: paper-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Native books/epoch, историческая<BR ALIGN="LEFT"/>provenance + выбранный release pins,<BR ALIGN="LEFT"/>действительные bindings, свежие Futures и BBO</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Единственный Paper writer; Futures<BR ALIGN="LEFT"/>receive, WAL/ACK, исполнение/сопровождение;<BR ALIGN="LEFT"/>штатный R08 child</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Paper WAL/checkpoints/books/financial<BR ALIGN="LEFT"/>heads, health и owner projections; /r08 producer<BR ALIGN="LEFT"/>outputs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: paper-runner, Paper engine</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"timeframe-manager" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-timeframe-manager-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: timeframe-manager</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Собственные M15/M30/H1/H4 контексты,<BR ALIGN="LEFT"/>phase/strength, Paper state и genuine source<BR ALIGN="LEFT"/>bindings</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Четыре независимых TF decisions →<BR ALIGN="LEFT"/>CommandBus</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: trading/manager/*,<BR ALIGN="LEFT"/>timeframe_command_memory,<BR ALIGN="LEFT"/>timeframe_manager_latest/health</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: Manager daemon, own-inputs, state-adapter</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"intrabar-supervisor" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>btcml-vps-smoke-intrabar-supervisor-1</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: intrabar-supervisor</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Paper/Timeframe owner health,<BR ALIGN="LEFT"/>control/config и shared runtime state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Существующий supervisor/наблюдатель<BR ALIGN="LEFT"/>execution служб</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: runtime/intrabar_supervision_state.json<BR ALIGN="LEFT"/>и штатные журналы</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: supervisor</FONT></TD></TR></TABLE>>, fillcolor="#E8F0FA"];
"r08" [shape=box, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#102A43"><B>R08 CHILD · inside Paper</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OWNER: paper-manager (one child)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">INPUT: Spot aggTrade + own-TF kline close;<BR ALIGN="LEFT"/>Context/policy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">WORK: Recorder ACK -&gt; worker -&gt; provider -&gt; R08</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">OUTPUT: Prefix; frozen INIT; descriptor/source<BR ALIGN="LEFT"/>bindings</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#64748B">SOURCE: R08 child owner, Recorder, R08 adapter/handoff,<BR ALIGN="LEFT"/>Baseline provider</FONT></TD></TR></TABLE>>, fillcolor="#F1F5F9"];
subgraph cluster_paper { label="ONE PAPER CONTAINER / ONE WRITER OWNER"; color="#A8BDCF"; style="rounded"; "paper-manager"; "r08"; }
"spot" -> "collector-watchdog" [label="02E01 · Spot OHLCV\nkline_15m WSS JSON\nnative updates", color="#147D83"];
"spot" -> "cognition-runtime" [label="02E02 · Spot event-time observations\ncombined aggTrade/bookTicker JSON\neach received message", color="#147D83"];
"spot" -> "r08" [label="02E03 · Genuine Spot contributors + closes\ncombined WSS JSON\neach original receive", color="#147D83"];
"futures" -> "legacy-multi-exchange" [label="02E04 · Futures trade snapshots\nfapi REST JSON -> Parquet\nnative 5s save interval", color="#147D83"];
"futures" -> "paper-manager" [label="02E05 · Execution market\nFutures aggTrade + bookTicker WSS\neach received message", color="#147D83"];
"legacy-multi-exchange" -> "legacy-volume-clusters" [label="02E06 · Native flow snapshot\n/legacy/multi_exchange_flow.parquet\nnative pair loops", color="#147D83"];
"legacy-multi-exchange" -> "legacy-volume-memory" [label="02E07 · Native flow snapshot\nshared /legacy Parquet\nnative pair loops", color="#147D83"];
"legacy-multi-exchange" -> "legacy-volume-reactions" [label="02E08 · Native flow snapshot\nshared /legacy Parquet\nnative pair loops", color="#147D83"];
"legacy-volume-clusters" -> "legacy-volume-memory" [label="02E09 · Volume clusters\n/legacy/volume_clusters.parquet\nMemory native read", color="#147D83"];
"collector-watchdog" -> "canonical-runtime" [label="02E10 · Spot OHLCV history\ndata/live Parquet + partitions\ndependency-ready engine pass", color="#147D83"];
"legacy-volume-reactions" -> "canonical-runtime" [label="02E11 · Admitted native reactions\nLegacy source adapter + receipt\ninput availability guard", color="#147D83"];
"legacy-volume-clusters" -> "canonical-runtime" [label="02E12 · Native Inventory publications\nLegacy adapter / cognitive extension\nnative admitted snapshot", color="#147D83"];
"legacy-volume-memory" -> "canonical-runtime" [label="02E13 · Regime publication; Memory remains\nnative history\nLegacy adapter / cognitive extension\nnative admitted snapshot", color="#147D83"];
"canonical-runtime" -> "context-refresh-daemon" [label="02E14 ·\nCandle/response/convergence/cognition inputs\nseven INPUTS + frozen native snapshot\none daemon child; interval900s", color="#147D83"];
"collector-watchdog" -> "context-refresh-daemon" [label="02E15 · Closed market inputs\nlive_market_feed.parquet\nsafe-close dependency", color="#147D83"];
"context-refresh-daemon" -> "cognition-runtime" [label="02E16 · Closed own-TF contexts\nClosedBarContextEventBridge\nnew admitted generation", color="#147D83"];
"context-refresh-daemon" -> "timeframe-manager" [label="02E17 · Own Final / Lifecycle / Phase\nParquet + owner publications\nmanager configured60s cycle", color="#147D83"];
"context-refresh-daemon" -> "context-refresher" [label="02E18 · Own-TF context generations\nFinal/Lifecycle Parquet\nconfigured20s; skip unchanged", color="#147D83"];
"cognition-runtime" -> "context-refresher" [label="02E19 · Provisional observation\nintrabar_cognition_health.json\nread-only projection", color="#147D83"];
"r08" -> "timeframe-manager" [label="02E20 · Committed source/evidence bindings\n/r08 descriptor + JournalV3\npublished INIT; reader refresh", color="#147D83"];
"timeframe-manager" -> "paper-manager" [label="02E21 · Own-TF commands\ntimeframe_command_memory.parquet\nnew command_id; own cursor", color="#147D83"];
"context-refresher" -> "dashboard-ui" [label="02E22 · Visual/chart payloads\nshared visual volume /visual-data\nnew projection; HTTP GET", color="#147D83"];
"ops-api" -> "dashboard-ui" [label="02E23 · Read-only API / WS / health\nnginx reverse proxy -> ops-api:8080\nbrowser/API requests", color="#147D83"];
"paper-manager" -> "ops-api" [label="02E24 · Health, financial and position\nstatus\nshared data; read-only API\nowner committed output", color="#147D83"];
"cognition-runtime" -> "ops-api" [label="02E25 · Cognition health / CTX journal\nowner files; read-only API\nAPI observation", color="#147D83"];
"paper-manager" -> "r08" [label="02E26 · Launch existing child\nsame process namespace; no new service\nnative bootstrap gates", color="#BA7A10", style=dashed];
"intrabar-supervisor" -> "paper-manager" [label="02E27 · Observe Compose-owned role\nhealth / PID / heartbeat\nexisting supervision loop", color="#8996A5", style=dotted, constraint=false];
"intrabar-supervisor" -> "timeframe-manager" [label="02E28 · Observe Compose-owned role\nhealth / PID / heartbeat\nexisting supervision loop", color="#8996A5", style=dotted, constraint=false];
"intrabar-supervisor" -> "cognition-runtime" [label="02E29 · Observe Compose-owned role\nhealth / PID / heartbeat\nexisting supervision loop", color="#8996A5", style=dotted, constraint=false];
}
