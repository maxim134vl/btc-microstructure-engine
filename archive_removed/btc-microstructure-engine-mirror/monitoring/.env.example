# ============================================================================
# BTC Microstructure Engine — Observability Platform
# Copy to .env and fill in. NEVER commit .env.
# ============================================================================

COMPOSE_PROJECT_NAME=btc_obs
TZ=UTC
LOG_LEVEL=INFO
ENVIRONMENT=dev                       # dev | prod

CADVISOR_VERSION=v0.49.1
NODE_EXPORTER_VERSION=v1.8.2
REDIS_VERSION=7.4-alpine

# health-api is the only host-published service.
HEALTH_API_PORT=8080
HEALTH_API_REFRESH_INTERVAL_SECONDS=5
HEALTH_API_UPSTREAM_TIMEOUT_SECONDS=3

METRICS_EXPORTER_SCAN_INTERVAL_SECONDS=10
METRICS_EXPORTER_FEATURE_SAMPLE_ROWS=2000

ALERT_ENGINE_EVAL_INTERVAL_SECONDS=15
ALERT_ENGINE_COOLDOWN_DEFAULT_SECONDS=300

WATCHDOG_STALL_THRESHOLD_SECONDS=120
WATCHDOG_RESTART_BUDGET_PER_HOUR=10
WATCHDOG_DRY_RUN=true
WATCHDOG_ENABLED=true
