# Show Visual Cognition, Stage 1 Review, and Cognitive Review in sidebar navigation.
# Hidden modules remain reachable via direct hash URL when false.
DASHBOARD_EXPERIMENTAL_MODULES=false

# Live ops monitor API (default: direct http://127.0.0.1:8080 — no Vite proxy spam).
# VITE_DASHBOARD_API_BASE=http://127.0.0.1:8080/api/v1
# VITE_DASHBOARD_WS_URL=ws://127.0.0.1:8080/ws/live

# Optional: route /api and /ws through Vite proxy instead of direct :8080.
# DASHBOARD_USE_VITE_PROXY=1
# DASHBOARD_API_PROXY_TARGET=http://127.0.0.1:8080
# DASHBOARD_WS_PROXY_TARGET=ws://127.0.0.1:8080
