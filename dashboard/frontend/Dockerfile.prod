# syntax=docker/dockerfile:1
#
# Production frontend image: build the Vite/React SPA, then serve it with nginx
# while reverse-proxying /api, /ws and /health to the dashboard API. The SPA talks
# to the backend over RELATIVE paths (and WS to window.location.host), so it must
# be served from the SAME origin as the API — nginx provides exactly that.
#
#   docker build -f dashboard/frontend/Dockerfile.prod -t btc-ml-dashboard-ui dashboard/frontend

# --- build stage -------------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci 2>/dev/null || npm install
COPY . .
RUN npm run build

# --- serve stage -------------------------------------------------------------
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
